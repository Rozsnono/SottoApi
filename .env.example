# Sotto API – környezeti változók (minta). A valódi értékeket `.env.local`-ba írd; az SOHA nem kerül gitbe.
# Generálás: `openssl rand -base64 32` (32 bájtos kulcsokhoz), `openssl rand -hex 32` (titkokhoz).

# MongoDB (natív mongod vagy Atlas; fejlesztéshez: `npm run db:dev` kiír egy URL-t)
DATABASE_URL=mongodb://127.0.0.1:27027/sotto

# Felhasználói JWT aláíró titok (min. 32 karakter)
JWT_SECRET=
# Admin munkamenet-süti aláíró titok (min. 32 karakter, KÜLÖN a JWT_SECRET-től)
ADMIN_SESSION_SECRET=
# Közös admin jelszó (min. 12 karakter)
ADMIN_PASSWORD=
# Admin azonosító az audit naplóhoz
ADMIN_ID=admin
# Opcionális: TOTP titok (base32) az admin belépéshez
ADMIN_TOTP_SECRET=

# Beállítások (pl. médiakulcsok) nyugalmi titkosításához: 32 bájt base64
CONFIG_ENCRYPTION_KEY=

# Moderációs PUBLIKUS kulcs (X25519, base64). A privát kulcs soha nem kerül a szerverre.
MODERATION_PUBLIC_KEY=

# Cron végpontok védelme (min. 16 karakter)
CRON_SECRET=

# Csak fejlesztés: helyi lemezes média adapter gyökere
LOCAL_MEDIA_DIR=.data/media
